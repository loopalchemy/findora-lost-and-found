{
  "name": "university-lost-and-found",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
