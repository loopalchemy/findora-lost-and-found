# Copy this file to backend/.env and replace the placeholders locally.
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=replace_me
DB_NAME=university_lost_found

# Generate a new long random secret locally; never commit it.
JWT_SECRET=replace_with_at_least_64_random_hex_characters
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=luf_session
CSRF_COOKIE_NAME=luf_csrf
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
